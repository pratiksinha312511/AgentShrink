# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Required for cloud providers ---
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=your-gemini-key-here

# --- Target agent provider ---
# Use "openai" or "gemini" for paid cloud baselines, "ollama" for free local testing
TARGET_AGENT_PROVIDER=openai
TARGET_AGENT_OPENAI_MODEL=gpt-4o-mini
TARGET_AGENT_GEMINI_MODEL=gemini-2.0-flash-lite
TARGET_AGENT_OLLAMA_MODEL=llama3.2:3b
TARGET_AGENT_TEMPERATURE=0

# --- Ollama settings (critical for 8GB RAM) ---
# Forces Ollama to unload previous model before loading next
# WITHOUT THIS: two models may load simultaneously and crash your machine
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_HOST=http://localhost:11434

# --- AgentShrink settings ---
AGENTSHRINK_DB_PATH=~/.agentshrink/logs.db
AGENTSHRINK_LOG_LEVEL=INFO

# --- Quality evaluation ---
# Model used as the "judge" — GPT-4o-mini is cheapest at ~$0.002/eval
AGENTSHRINK_JUDGE_MODEL=gpt-4o-mini
AGENTSHRINK_QUALITY_THRESHOLD=0.85   # 85% quality to approve replacement
AGENTSHRINK_CONFIDENCE_THRESHOLD=0.75 # 75% centroid similarity to route to SLM
# Cost baseline shown in the dashboard even for local-only runs
AGENTSHRINK_ESTIMATE_MODEL=gpt-4o-mini
