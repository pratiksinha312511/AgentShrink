# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Required ---
OPENAI_API_KEY=sk-your-key-here

# --- Ollama settings (critical for 8GB RAM) ---
# Forces Ollama to unload previous model before loading next
# WITHOUT THIS: two models may load simultaneously and crash your machine
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_HOST=http://localhost:11434

# --- AgentShrink settings ---
AGENTSHRINK_DB_PATH=~/.agentshrink/logs.db
AGENTSHRINK_LOG_LEVEL=INFO

# --- Quality evaluation ---
# Model used as the "judge" — GPT-4o-mini is cheapest at ~$0.002/eval
AGENTSHRINK_JUDGE_MODEL=gpt-4o-mini
AGENTSHRINK_QUALITY_THRESHOLD=0.85   # 85% quality to approve replacement
AGENTSHRINK_CONFIDENCE_THRESHOLD=0.75 # 75% centroid similarity to route to SLM
