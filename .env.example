# Copy this file to .env and fill in your values

# --- Required for cloud providers ---
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=your-gemini-key-here
NVIDIA_API_KEY=nvapi-your-key-here
HF_TOKEN=hf_your_token_here
MODAL_TOKEN_ID=ak-your-token-id
MODAL_TOKEN_SECRET=as-your-token-secret

# --- Target agent provider ---
# Use "openai", "nvidia", or "gemini" for paid cloud baselines.
# Use "ollama" for free local-only testing.
TARGET_AGENT_PROVIDER=openai
TARGET_AGENT_OPENAI_MODEL=gpt-4o-mini
TARGET_AGENT_NVIDIA_MODEL=moonshotai/kimi-k2-instruct
TARGET_AGENT_GEMINI_MODEL=gemini-2.0-flash-lite
TARGET_AGENT_OLLAMA_MODEL=llama3.2:3b
TARGET_AGENT_TEMPERATURE=0

# --- OpenAI-compatible base URLs ---
OPENAI_BASE_URL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- ShrinkLLM runtime routing ---
SHRINKLLM_FALLBACK_PROVIDER=ollama
SHRINKLLM_FALLBACK_MODEL=llama3.2:3b
SHRINKLLM_TRACE_MODE=1

# --- Ollama settings ---
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_HOST=http://localhost:11434

# --- AgentShrink settings ---
AGENTSHRINK_DB_PATH=~/.agentshrink/logs.db
AGENTSHRINK_LOG_LEVEL=INFO
AGENTSHRINK_QUALITY_THRESHOLD=0.85
AGENTSHRINK_CONFIDENCE_THRESHOLD=0.75
AGENTSHRINK_ESTIMATE_MODEL=gpt-4o-mini

# Optional custom price override for providers/models not hardcoded in logger.py.
# If token usage comes back from the provider, AgentShrink can use these rates
# to show estimated spend in the dashboard.
AGENTSHRINK_PRICE_MODEL=moonshotai/kimi-k2-instruct
AGENTSHRINK_PRICE_IN_PER_1K=
AGENTSHRINK_PRICE_OUT_PER_1K=
